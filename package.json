    "gsap": "3.15.0",
    "howler": "2.2.4",
    "sirv": "3.0.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/howler": "2.2.13",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
